# =============================================================================
#  server-medical-system — Git 属性规则
# =============================================================================
#
#  目的：保证**仓库内始终以 LF 存储**，并在检出时按需转换。
#  这对 shell 脚本尤其重要：带 CRLF 的 .sh 在 Linux 上会报
#  `#!/usr/bin/env bash^M: bad interpreter`。
# =============================================================================

# --------------------------------------------------------------------------- #
#  默认：仓库内一律存 LF，检出时不做转换（Windows 工具链同样能处理 LF）
# --------------------------------------------------------------------------- #
* text=auto eol=lf

# --------------------------------------------------------------------------- #
#  必须保持 LF 的文件
# --------------------------------------------------------------------------- #
*.sh        text eol=lf
*.bash      text eol=lf
*.ps1       text eol=lf
*.go        text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.example   text eol=lf

# --------------------------------------------------------------------------- #
#  二进制：不做任何转换
# --------------------------------------------------------------------------- #
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.pdf       binary
*.dcm       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.zip       binary
*.gz        binary
*.exe       binary
*.db        binary
*.sqlite    binary

# --------------------------------------------------------------------------- #
#  标记为可执行的脚本
# --------------------------------------------------------------------------- #
deploy.sh   text eol=lf
install.sh  text eol=lf
