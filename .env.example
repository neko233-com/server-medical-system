# =============================================================================
#  server-medical-system — 环境变量示例
#
#  用法：复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会入库）。
#        Windows PowerShell:  Copy-Item .env.example .env
#        Linux / macOS:       cp .env.example .env
#
#  说明：所有变量均有内置默认值，不配置任何变量也可直接一键部署
#       （默认 = 内置 SQLite + 6970 端口 + ./uploads）。
# =============================================================================

# --------------------------------------------------------------------------- #
#  服务
# --------------------------------------------------------------------------- #
# HTTP 监听端口，默认 6970（刻意避开常见的 8080/3000，减少冲突）
PORT=6970
# CORS 允许的来源，逗号分隔。生产环境请填写具体域名，例如 https://his.example.com
ALLOWED_ORIGINS=*

# --------------------------------------------------------------------------- #
#  安全
# --------------------------------------------------------------------------- #
# JWT 签名密钥。生产环境【必须】替换为高强度随机串！
# 生成方式： openssl rand -hex 32
JWT_SECRET=please-change-this-to-a-long-random-string

# --------------------------------------------------------------------------- #
#  数据库（默认内置 SQLite，可切换为外置 Postgres / MySQL）
# --------------------------------------------------------------------------- #
# 可选值：sqlite（默认） | postgres | mysql
DB_DRIVER=sqlite
# sqlite 模式下的数据库文件路径（相对于启动目录）
DB_PATH=medical.db
# 外置数据库模式下的连接串（DB_DRIVER 为 postgres / mysql 时生效）
# PostgreSQL 示例：
# DB_DSN=host=127.0.0.1 port=5432 user=medical password=secret dbname=medical sslmode=disable TimeZone=Asia/Shanghai
# MySQL 示例：
# DB_DSN=medical:secret@tcp(127.0.0.1:3306)/medical?charset=utf8mb4&parseTime=True&loc=Local

# --------------------------------------------------------------------------- #
#  文件存储
# --------------------------------------------------------------------------- #
# 影像样片（CT / X 光）上传存放目录
UPLOAD_DIR=./uploads

# --------------------------------------------------------------------------- #
#  种子数据
# --------------------------------------------------------------------------- #
# 是否注入演示数据（演示账号、门诊房间、打印机、60+ 常用药）。
# 生产环境建议设为 false，仅创建 admin / doctor 基础账号。
SEED_DEMO=true

# --------------------------------------------------------------------------- #
#  日志轮转（内置零依赖 rotating writer）
# --------------------------------------------------------------------------- #
LOG_DIR=./logs
# 单文件超过该大小即切分
LOG_MAX_MB=64
# 日志保留天数
LOG_KEEP_DAYS=31

# --------------------------------------------------------------------------- #
#  院内即时通讯（浮窗聊天）
# --------------------------------------------------------------------------- #
# 聊天消息保留天数（超出即从数据库删除）
CHAT_RETENTION_DAYS=31
# 单个会话最多保留的消息条数，超出从最旧一条开始 LRU 淘汰
CHAT_MAX_PER_CONVERSATION=2000

# --------------------------------------------------------------------------- #
#  界面默认语言
# --------------------------------------------------------------------------- #
# 当请求未携带 Accept-Language 时的回退语言：zh-CN | en-US ...
DEFAULT_LANG=zh-CN
